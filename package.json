{
  "name": "tiny-park",
  "version": "1.0.0",
  "description": "Tiny Park team-versus game and level studio",
  "scripts": {
    "build": "node scripts/build.cjs",
    "dev": "npm run build && wrangler pages dev",
    "dev:test": "npm run build && wrangler d1 migrations apply tiny-park-levels --local && wrangler pages dev --port 8788",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "playwright test",
    "deploy": "npm run build && wrangler pages deploy dist --project-name tiny-park",
    "relay": "node server/index.js",
    "relay:dev": "npm run build && node scripts/relay-dev.cjs",
    "relay:test": "node scripts/relay-test-server.cjs",
    "realtime:dev": "wrangler dev --config relay-worker/wrangler.jsonc --port 8790",
    "realtime:deploy": "wrangler deploy --config relay-worker/wrangler.jsonc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xyxyxyrex/picoParkClone.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/xyxyxyrex/picoParkClone/issues"
  },
  "homepage": "https://github.com/xyxyxyrex/picoParkClone#readme",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "peer": "^1.0.2",
    "prettier": "^3.9.6",
    "wrangler": "^4.129.1"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
