{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tiny-park-realtime",
  "main": "./index.js",
  "compatibility_date": "2026-09-13",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "ParkRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ParkRoom"],
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
